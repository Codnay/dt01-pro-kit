# Copy to .env (setup.sh does this for you) and fill in.
# This file holds your secrets. It is never committed.

# A short name for this robot. Letters, digits, '.', '_' and '-'.
# The VR control room and the camera room are named after it.
ROBOT_ID=dt01-pro-01

# Your LiveKit project (free at https://cloud.livekit.io -> Settings -> Keys).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
